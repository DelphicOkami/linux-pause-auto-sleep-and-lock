#!/usr/bin/env python3
"""pause-auto-sleep

Small utility to request an idle inhibition from the session power
management D-Bus interface so automatic suspend and screen locking are
temporarily prevented.

Usage examples:
    pause-auto-sleep "application_name or desktop.entry.name" "reason_for_inhibit"
    pause-auto-sleep         # toggle mode: defaults to inhibitor "User" and reason "Manually enabled"

To show an application icon/name in KDE Plasma widgets, use the desktop
entry name (e.g. `org.kde.konsole`). To locate desktop entry files:
    ls /usr/share/applications ~/.local/share/applications | grep -i YOUR_PROGRAM_NAME
"""

import atexit
import functools
import sys
try:
    import dbus
except ImportError:
    print("Error: python-dbus bindings are required. Install your distro package (e.g. python3-dbus) and try again.", file=sys.stderr)
    sys.exit(1)
import tempfile
import os
import re
import hashlib
import signal
import logging
import time
import argparse
from multiprocessing.connection import Listener, Client
import socket
from enum import Enum
from typing import Callable, Optional, List

_registered_cleanup: List[Callable[[], None]] = []
_atexit_registered = False

# Capture this at import time so atexit-registered cleanup callables can
# still resolve it after Python 3.14 begins clearing module globals during
# interpreter shutdown.
_SCRIPT_BASENAME = os.path.basename(__file__)

def get_all_signals():
    """Return a list of signals that should trigger cleanup handlers.

    This list is used as a sensible default set of signals to register
    for cleanup/exit handling.
    """
    return [signal.SIGINT, signal.SIGTERM, signal.SIGTRAP, signal.SIGABRT, signal.SIGBUS, signal.SIGALRM]

def register_exit_function(fun: Optional[Callable[[], None]] = None, signals: Optional[List[int]] = None):
    """Register a cleanup function to run on normal exit and optionally on signals.

    Usage:
      register_exit_function(my_cleanup)
      register_exit_function(my_cleanup, signals=[signal.SIGINT, signal.SIGTERM])

    Can also be used as a decorator: `@register_exit_function()`
    """
    global _atexit_registered

    def run_cleanup():
        for f in list(_registered_cleanup):
            try:
                f()
            except Exception:
                logging.exception('Error running cleanup function')

    def ensure_atexit():
        global _atexit_registered
        if not _atexit_registered:
            atexit.register(run_cleanup)
            _atexit_registered = True

    def add_and_register(fun_to_add: Callable[[], None], sigs: Optional[List[int]]):
        if not callable(fun_to_add):
            raise TypeError(f'{getattr(fun_to_add, "__name__", "Unknown")} is not callable')
        if fun_to_add not in _registered_cleanup:
            _registered_cleanup.append(fun_to_add)
        ensure_atexit()
        if sigs:
            for sig in sigs:
                def handler(signum, frame):
                    # Trigger atexit-registered cleanup via SystemExit. We
                    # deliberately do not chain to the previous handler:
                    # Python's default SIGINT handler raises
                    # KeyboardInterrupt, which would escape this signal
                    # handler and print a confusing traceback.
                    sys.exit(128 + signum)

                signal.signal(sig, handler)

    if fun is None:
        def decorator(f):
            add_and_register(f, signals)
            return f

        return decorator
    else:
        add_and_register(fun, signals)
        return fun


class close_reasons(Enum):
    """Reason codes used when requesting an existing inhibitor to close.

    The enum values are sent across the local socket so the running
    instance knows why it was asked to terminate.
    """
    CLOSE_REQUESTED = 1
    NEW_INSTANCE = 2
    SIGNAL_RECEIVED = 3
    CTRL_C = 4
    TERM = 5

    def get_string(reason:close_reasons):
        """Return a human-readable string for a `close_reasons` value.

        Args:
            reason: `close_reasons` enum value.

        Returns:
            A short description string.
        """
        match reason:
            case close_reasons.CLOSE_REQUESTED:
                return "User requested closure"
            case close_reasons.NEW_INSTANCE:
                return "New instance started"
            case close_reasons.SIGNAL_RECEIVED:
                return "Signal received"
            case close_reasons.CTRL_C:
                return "Ctrl + c caught"
            case close_reasons.TERM:
                return "Terminate signal caught"
            case _:
                raise ValueError('Unknown value')

class power_management_inhibitor:
    """Helper to interact with KDE's Solid PolicyAgent D-Bus API.

    Uses `org.kde.Solid.PowerManagement.PolicyAgent.AddInhibition` so that
    inhibitions are tracked against this process's bus name and released
    automatically by KDE if the process dies before calling
    `ReleaseInhibition`. The freedesktop proxy
    (`org.freedesktop.PowerManagement.Inhibit`) does not always do this
    cleanly, which historically left zombie inhibitions in the session.
    """

    # KDE PolicyAgent RequiredPolicy bitmask: InterruptSession (1) blocks
    # automatic suspend and screen locking; ChangeProfile (2) blocks the
    # power-saving profile from kicking in. Together they match the
    # behavior the freedesktop proxy used to give us.
    _POLICY_TYPES = 1 | 2

    def __init__(self):
        bus = dbus.SessionBus()
        self.policy_agent = bus.get_object(
            'org.kde.Solid.PowerManagement.PolicyAgent',
            '/org/kde/Solid/PowerManagement/PolicyAgent',
        )

    def start_inhibit(self, inhibitor: str, reason: str):
        """Request an inhibition and return a cookie.

        Args:
            inhibitor: Application or desktop entry name shown to the session.
            reason: Short text describing why the inhibition is requested.

        Returns:
            The inhibitor cookie (opaque integer) or None on failure.
        """
        try:
            cookie = self.policy_agent.AddInhibition(
                dbus.UInt32(self._POLICY_TYPES), inhibitor, reason,
                dbus_interface='org.kde.Solid.PowerManagement.PolicyAgent',
            )
            logging.info('Blocking sleep and screen locking')
            logging.info(f'By: {inhibitor}')
            logging.info(f'Reason: {reason}')
            return cookie
        except Exception:
            logging.exception('Failed to acquire inhibition via D-Bus')
            return None

    def stop_inhibit(self, cookie: dbus.UInt32):
        """Release a previously acquired inhibitor cookie.

        Args:
            cookie: The inhibitor cookie returned by `AddInhibition`.
        """
        try:
            self.policy_agent.ReleaseInhibition(
                cookie,
                dbus_interface='org.kde.Solid.PowerManagement.PolicyAgent',
            )
            logging.info('Releasing sleep and screen locking block')
        except Exception:
            logging.exception('Failed to release inhibitor cookie')
    
def close_existing(address, reason:close_reasons):
    """Ask a running instance (if any) to close the inhibitor.

    The function connects to a local `multiprocessing.connection` socket
    and sends a `close` command followed by the numeric reason code.
    If no listener is present the call is silently ignored.
    """
    try:
        conn = Client(*address)
        conn.send("close")
        conn.send(reason.value)
        conn.close()
    except socket.error:
        return

def listen_for_close(address, release_attempted=False):
    """Block and listen on the socket for a close request.

    Connections are accepted in a loop. A client that connects but never
    sends a clean `close` (or half-closes) is dropped after a short poll
    timeout instead of blocking the listener forever: the previous
    single-`accept()`-then-`recv()` design could wedge permanently on such
    a connection, leaving an inhibitor that no later `--release` could ever
    reach. When a valid `CLOSE` message (followed by its numeric reason) is
    received the function returns so cleanup can run. If the socket path is
    stale the first attempt removes it and retries once.
    """
    try:
        listener = Listener(*address)
    except OSError:
        if not release_attempted:
            logging.info('Clearing existing socket')
            release_socket(address[0])
            listen_for_close(address, True)
            return
        raise

    try:
        while True:
            conn = listener.accept()
            try:
                # A genuine close request sends "close" right away. If
                # nothing arrives, drop this connection and accept the next
                # rather than blocking in recv() indefinitely.
                if not conn.poll(5):
                    continue
                msg = conn.recv()
                if not (isinstance(msg, str) and msg.upper() == 'CLOSE'):
                    continue
                reason = conn.recv() if conn.poll(1) else None
                if reason is not None:
                    try:
                        logging.info(f'Closing due to {close_reasons.get_string(close_reasons(reason))}')
                    except Exception:
                        pass
                return
            except (EOFError, OSError):
                continue
            finally:
                conn.close()
    finally:
        listener.close()


def list_inhibitions():
    """Return active inhibitions as a list of (app_name, reason) tuples.

    Queries KDE's `org.kde.Solid.PowerManagement.PolicyAgent` directly.
    Raises `dbus.exceptions.DBusException` on D-Bus failure.
    """
    bus = dbus.SessionBus()
    agent = bus.get_object('org.kde.Solid.PowerManagement.PolicyAgent',
                           '/org/kde/Solid/PowerManagement/PolicyAgent')
    raw = agent.ListInhibitions(
        dbus_interface='org.kde.Solid.PowerManagement.PolicyAgent')
    return [(str(app), str(reason)) for app, reason in raw]


def identity_slug(inhibitor: str) -> str:
    """Return a filesystem-safe slug identifying an inhibitor.

    Each logical lock is keyed by its inhibitor name (the first CLI
    argument, e.g. `User` for the tray or `SSH` for the SSH watchdog) so
    that independent locks get independent socket/state files and never
    interfere. Common names like `User`, `SSH` or `org.kde.konsole` stay
    human-readable; names containing characters unsafe for a filename (or
    longer than 64 chars) are sanitised and disambiguated with a short hash
    so two different names can never collide onto the same slug.
    """
    safe = re.sub(r'[^A-Za-z0-9._-]', '_', inhibitor)[:64]
    if safe != inhibitor:
        digest = hashlib.sha1(inhibitor.encode('utf-8')).hexdigest()[:8]
        safe = f'{safe}-{digest}'
    return safe


def socket_path(inhibitor: str) -> str:
    """Return the per-identity UNIX socket path for `inhibitor`."""
    return os.path.join(
        tempfile.gettempdir(),
        f'{_SCRIPT_BASENAME}-{os.getuid()}-{identity_slug(inhibitor)}.socket',
    )


def state_file_path(inhibitor: str) -> str:
    """Return the per-identity state file path for `inhibitor`."""
    return os.path.join(
        tempfile.gettempdir(),
        f'{_SCRIPT_BASENAME}-{os.getuid()}-{identity_slug(inhibitor)}.state',
    )


def write_state_file(inhibitor: str, reason: str) -> None:
    """Write the current (inhibitor, reason) so other tools can `--check` it.

    KDE's PolicyAgent does not reliably expose registered inhibitions back
    via `ListInhibitions` on all Plasma versions, so we keep a small local
    file describing what this process is currently holding. The file is
    keyed by inhibitor identity and removed by the `atexit`-registered
    cleanup on shutdown.
    """
    path = state_file_path(inhibitor)
    tmp = f'{path}.{os.getpid()}.tmp'
    try:
        with open(tmp, 'w') as f:
            f.write(f'{inhibitor}\n{reason}\n')
        os.replace(tmp, path)
    except OSError:
        logging.exception('Failed to write state file')


def remove_state_file(inhibitor: str) -> None:
    """Remove the state file written by `write_state_file` for `inhibitor`."""
    try:
        os.unlink(state_file_path(inhibitor))
    except FileNotFoundError:
        pass
    except OSError:
        logging.exception('Failed to remove state file')


def read_state_file(inhibitor: str) -> Optional[tuple]:
    """Return (inhibitor, reason) from the state file, or None if absent."""
    try:
        with open(state_file_path(inhibitor), 'r') as f:
            lines = f.read().splitlines()
        if len(lines) >= 2:
            return (lines[0], lines[1])
    except FileNotFoundError:
        return None
    except OSError:
        return None
    return None


def is_inhibition_held(inhibitor: str, reason: Optional[str] = None) -> bool:
    """Return True if a matching inhibition is currently active.

    Ground truth is the session PolicyAgent's live inhibition list, so a
    `--check` cannot be fooled by a missing/stale state file while the
    holding process is still alive (the failure mode that previously left
    orphaned inhibitors un-released). The local state file is only used as
    a fallback for Plasma versions whose `ListInhibitions` does not report
    registered inhibitions back.

    Matches `inhibitor` exactly against the app name; if `reason` is not
    None it must also match exactly.
    """
    try:
        for held_app, held_reason in list_inhibitions():
            if held_app == inhibitor and (reason is None or held_reason == reason):
                return True
    except dbus.exceptions.DBusException:
        # PolicyAgent unavailable or this Plasma version doesn't report
        # inhibitions back; fall through to the local state file.
        pass

    state = read_state_file(inhibitor)
    if state is None:
        return False
    held_app, held_reason = state
    return held_app == inhibitor and (reason is None or held_reason == reason)


def release_socket(path):
    """Remove the socket file at `path` if it exists.

    This is used to clean up stale UNIX domain socket files left by
    previous runs.
    """
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        logging.exception('Failed to remove socket file')

def get_cleanup_function(pm_bus: power_management_inhibitor, cookie: dbus.UInt32):
    """Return a cleanup callable that releases the inhibitor cookie.

    This is suitable for registering with `register_exit_function` or
    `atexit.register` to ensure the inhibitor is released on exit.
    """
    def cleanup():
        pm_bus.stop_inhibit(cookie)
    return cleanup

if __name__ == '__main__':
    logging.basicConfig(format='%(asctime)s %(levelname)s: %(message)s', level=logging.INFO)

    p = argparse.ArgumentParser()
    p.description = "Programatically block screen lock and sleep on linux, specifically KDE plasma"

    p.add_argument("--release", help="Does not block screen lock, instead releasing any existing manual blocks", action='store_true')
    p.add_argument("--list", help="Print active inhibitors (app: reason) and exit", action='store_true', dest='list_inhibitors')
    p.add_argument("--check", help="Exit 0 if an inhibition matching the given inhibitor (and optional reason) is held, else exit 1", action='store_true', dest='check_inhibitor')
    p.add_argument("--verbose", "-v", help="Enable verbose (debug) logging", action='store_true')
    p.add_argument("inhibitor", help="App, or desktop entry name", type=str, nargs='?', default=None)
    p.add_argument("reason", help="Reason to block", type=str, nargs='?', default=None)
    args = p.parse_args()

    # Apply defaults for the inhibit path only; --check uses None as a
    # wildcard for the reason, and the inhibitor is required for --check.
    if not args.check_inhibitor:
        if args.inhibitor is None:
            args.inhibitor = 'User'
        if args.reason is None:
            args.reason = 'Manually enabled'

    if args.verbose:
        logging.getLogger().setLevel(logging.DEBUG)

    # Handle --check before registering any exit/signal handlers: it must
    # be a pure read-only query and never disturb a running instance.
    if args.check_inhibitor:
        if args.inhibitor is None:
            print('--check requires an inhibitor name', file=sys.stderr)
            sys.exit(2)
        sys.exit(0 if is_inhibition_held(args.inhibitor, args.reason) else 1)

    if args.list_inhibitors:
        try:
            inhibitions = list_inhibitions()
        except dbus.exceptions.DBusException as e:
            print(f'Error querying PolicyAgent: {e}', file=sys.stderr)
            sys.exit(1)

        if not inhibitions:
            print('No active inhibitors found.')
            sys.exit(0)
        for app, reason in inhibitions:
            print(f'{app}: {reason}')
        sys.exit(0)

    # Socket is keyed by inhibitor identity so independent locks (e.g. the
    # tray's "User" and the watchdog's "SSH") never share a socket. By this
    # point args.inhibitor has been defaulted to "User" for the non-check
    # paths, so --release with no name targets the tray's lock.
    address = (socket_path(args.inhibitor), 'AF_UNIX')

    if args.release:
        close_existing(address, close_reasons.CLOSE_REQUESTED)
        sys.exit(0)

    # Install signal handlers so SIGINT/SIGTERM trigger a clean shutdown
    # (releasing the inhibitor via the atexit-registered cleanups below)
    # rather than a KeyboardInterrupt traceback. These handlers must NOT
    # message the socket: this process is the listener, so sending a close
    # on exit would tear down a *different* instance during handoff, and
    # would make read-only invocations like --list kill the live lock.
    register_exit_function(lambda: None, signals=[signal.SIGINT, signal.SIGTERM])

    # Ask any existing instance to exit (makes this run in toggle-style)
    close_existing(address, close_reasons.NEW_INSTANCE)

    inhibitor = power_management_inhibitor()
    cookie = inhibitor.start_inhibit(inhibitor=args.inhibitor, reason=args.reason)

    if cookie is None:
        logging.error('Could not acquire inhibitor; exiting')
        sys.exit(1)

    # Ensure we release cookie on exit
    register_exit_function(get_cleanup_function(inhibitor, cookie))

    # Publish what we're holding so `--check` can see it, and ensure the
    # state file is cleaned up on exit.
    write_state_file(args.inhibitor, args.reason)
    register_exit_function(functools.partial(remove_state_file, args.inhibitor))

    listen_for_close(address)